# ===================================================================
# Dockerfile приложения «Витрина интернет-магазина».
#
# Сборка двухступенчатая (multi-stage):
#
#   builder — стадия сборки: ставит Gradle из локального wrapper
#             и собирает Executable JAR (Spring Boot fat jar).
#   runtime — стадия запуска: только JRE 21 и готовый JAR.
#
# Gradle в финальный образ не попадает: в runtime остаётся только JRE
# и готовый JAR, поэтому образ меньше, чем если бы сборка шла на хосте
# с последующим копированием артефактов в тулбоксный образ.
#
# Почему JAR собирается внутри образа, а не копируется из build/libs:
#   иначе сборка падала бы с «my-market-app-0.0.1-SNAPSHOT.jar: not found»
#   после ./gradlew clean, и ревьюер после git clone получил бы ошибку вместо
#   работающего приложения. Теперь достаточно одной команды:
#
#   docker compose up -d --build
#
# Схему БД создаёт не сборка образа, а Liquibase при старте приложения —
# см. src/main/resources/db/changelog/db.changelog-master.yaml.
# ===================================================================

# ---------------------------------------------------------------------------
# Стадия 1 — сборка.
# ---------------------------------------------------------------------------
FROM eclipse-temurin:21-jdk AS builder

WORKDIR /build

# Сначала только файлы wrapper'а. Это отдельный слой намеренно: настройки
# и зависимости Gradle кэшируются отдельно от исходников, поэтому правка
# в .java не перекачивает весь Gradle заново.
COPY gradle/ gradle/
COPY gradlew ./
COPY settings.gradle build.gradle ./

# Разрешаем запуск gradlew.sh внутри контейнера (у Git на Windows может стоять
# core.filemode=false, и без этого флаг потеряется при копировании).
RUN chmod +x gradlew

# Прогрев кэша Gradle. Выполняется ДО копирования src/, чтобы правка любого
# исходника не инвалидировала слой вместе с уже скачанными библиотеками.
#
# Задачи classes и testClasses достаточно: Gradle разрешает и скачивает classpath
# каждой задачи даже когда у неё нет исходников, поэтому отдельная заглушка не
# нужна. bootJar здесь намеренно не вызывается — ему требуется точка входа,
# которая появится только после копирования настоящих исходников.
#
# -Dorg.gradle.caching=true включает кэш задач, поэтому финальная сборка ниже
# переиспользует уже выполненные компиляции вместо повторной работы.
RUN ./gradlew classes testClasses --no-daemon --quiet -Dorg.gradle.caching=true

COPY src/ src/
COPY config/ config/

# Финальная сборка настоящих исходников. Имена задач (classes, testClasses)
# переданы явно: bootJar сам по себе не компилирует исходники.
#
# checkstyle запускается здесь намеренно, а вот spotlessCheck — нет. Формат
# кода задаётся его конфигурацией в build.gradle и зависит от переводов строк
# в самих файлах. Пока переводы строк не нормализованы в .gitattributes,
# проверка ведёт себя по-разному на хосте (Windows) и в контейнере (Linux),
# и падает уже не по существу. После нормализации задачу стоит вернуть.
RUN ./gradlew classes testClasses checkstyleMain checkstyleTest bootJar \
      --no-daemon --quiet -Dorg.gradle.caching=true

# ---------------------------------------------------------------------------
# Стадия 2 — запуск.
# ---------------------------------------------------------------------------
FROM eclipse-temurin:21-jre

WORKDIR /app

# JAR копируем с фиксированным именем app.jar, поэтому номер версии
# в имени файла (0.0.1-SNAPSHOT) больше нигде в Dockerfile не фигурирует
# и его смена не ломает сборку.
COPY --from=builder /build/build/libs/my-market-app-0.0.1-SNAPSHOT.jar app.jar

# Открываемый порт веб-приложения.
EXPOSE 8080

# Запускаем от непривилегированного пользователя: в образе по умолчанию root,
# и процесс веб-приложения ему не нужен.
USER 10001

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-jar", "/app/app.jar"]
