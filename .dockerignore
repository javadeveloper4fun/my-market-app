*.ipr

# Сборка
# Исключаем артефакты сборки, кроме bootJar в build/libs:
# docker compose собирает образы из заранее собранных jar.
.gradle/
**/build/classes/
**/build/generated/
**/build/reports/
**/build/resources/
**/build/test-results/
**/build/tmp/
**/build/libs/*-plain.jar

# Временные и аналитические файлы
analize*.txt
